# =============================================
# Squad Traffic Analyzer — Configuration
# Copy to .env and fill in your values
# =============================================

# --- Application ---
ENVIRONMENT=production        # development | production (production hides /docs)
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# --- Squad Server ---
SQUAD_SERVER_IP=1.2.3.4       # Your Squad server IP (used for traffic filtering)
SQUAD_GAME_PORT=7787
SQUAD_QUERY_PORT=27165

# --- Database (PostgreSQL) ---
DB_PASSWORD=changeme          # Postgres password (used by docker-compose)

# --- Redis ---
REDIS_PASSWORD=changeme       # Redis password

# --- Storage ---
PCAP_DIR=/app/pcap_captures  # The only directory the API reads/writes PCAPs in (/analyze/path is restricted to it)
PCAP_RETENTION_DAYS=7

# --- Analysis Mode ---
ANALYSIS_MODE=manual          # manual | continuous | scheduled
AUTO_CAPTURE_ENABLED=false

# continuous mode
CONTINUOUS_INTERVAL_SECONDS=300
CAPTURE_DURATION_SECONDS=60
CAPTURE_INTERFACE=eth0        # Network interface: find with `ip a`

# scheduled mode (cron)
SCHEDULED_CRON=0 */6 * * *

# --- Security (optional) ---
API_KEY_ENABLED=false
API_KEY=                      # Random key, e.g.: openssl rand -hex 16

# --- Anomaly Detection ---
ANOMALY_THRESHOLD_PPS=10000
ANOMALY_THRESHOLD_BPS=100000000
ANOMALY_THRESHOLD_PORT_SCAN=20
ML_ENABLED=true
ML_MODEL_CONTAMINATION=0.1

# --- Notifications (optional) ---

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_TO=
EMAIL_PASSWORD=

# Webhook
WEBHOOK_ENABLED=false
WEBHOOK_URL=
